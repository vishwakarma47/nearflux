# Existing Render deployment settings
CLIENT_ORIGIN=https://nearflux-p2p-share.onrender.com
RENDER_EXTERNAL_URL=https://nearflux-p2p-share.onrender.com

# Keep the main Render service on rooms, signaling, presence, and the web app.
TELEGRAM_BRIDGE_MODE=remote
BRIDGE_SHARED_SECRET=

# Telegram credentials are used by the standalone bridge host in bridge/.env.
# They are retained here only for compatibility with the legacy in-process mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=https://nearflux-p2p-share.onrender.com/
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MAX_FILE_BYTES=20971520

# Optional legacy/local signaling override; remote bridge uses BRIDGE_SOCKET_URL on the bridge host.
# NEARFLUX_INTERNAL_URL=http://127.0.0.1:3000
