NODE_ENV=production
PORT=8080

# Public URL of the standalone bridge host. Used for the Telegram webhook.
BRIDGE_PUBLIC_URL=https://bridge.example.com
TELEGRAM_WEBHOOK_URL=https://bridge.example.com/telegram/webhook

# Existing Render NearFlux service URL used for Socket.IO rooms and signaling.
BRIDGE_SOCKET_URL=https://nearflux-p2p-share.onrender.com

# Same random value must be configured on Render and the bridge host.
BRIDGE_SHARED_SECRET=replace-with-a-long-random-secret

# Server-side Telegram credentials. Never expose these to the browser.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_WEBAPP_URL=https://nearflux-p2p-share.onrender.com/
TELEGRAM_MAX_FILE_BYTES=20971520

# STUN is optional but recommended. TURN can be added later if direct paths fail.
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# Configure the host/provider firewall for the UDP range used by the native runtime.
WEBRTC_UDP_MIN_PORT=40000
WEBRTC_UDP_MAX_PORT=49999
